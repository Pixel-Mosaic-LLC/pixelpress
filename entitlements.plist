<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Hardened-runtime exceptions for PixelPress.app (a PyInstaller-built Python + Tk app).
     allow-unsigned-executable-memory: Python's ctypes/libffi callbacks.
     disable-library-validation: lets the bundled Python load its extension modules and Tk's tkdnd. -->
<plist version="1.0">
<dict>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
</dict>
</plist>
